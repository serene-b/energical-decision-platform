APP_NAME=Energical Decision Platform API
APP_VERSION=0.1.0
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_BYTES=10485760
PERSISTENCE_BACKEND=memory
# Set PERSISTENCE_BACKEND=postgres only after the supplied schema is applied.
DATABASE_URL=
API_AUTH_TOKEN=
# Optional provider boundary. If unset, assistant requests stop at the safe context layer.
ASSISTANT_PROVIDER_URL=
