APP_NAME=Energical Decision Platform API
APP_VERSION=0.1.0
APP_ENV=development
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=10485760

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:sirine1636@localhost:5433/energical_platform

# Groq AI Assistant Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
API_AUTH_TOKEN=
ASSISTANT_PROVIDER_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=llama-3.3-70b-versatile

# Google Analytics 4 API Integration (Optional)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
